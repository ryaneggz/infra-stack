# Copy with `make init`; that command replaces CHANGE_ME values atomically.
COMPOSE_PROJECT_NAME=infra-stack
BIND_HOST=127.0.0.1
INFRA_NETWORK=infra

POSTGRES_IMAGE=timescale/timescaledb-ha:pg17.6-ts2.21.3-all
POSTGRES_USER=infra
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
POSTGRES_DB=app
POSTGRES_PORT=5432
POSTGRES_CPUS=1.50
POSTGRES_MEMORY=2g

REDIS_IMAGE=redis:7.4.7-alpine
REDIS_PASSWORD=CHANGE_ME_REDIS
REDIS_PORT=6379
REDIS_CPUS=0.50
REDIS_MEMORY=512m

MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
AWS_CLI_IMAGE=amazon/aws-cli:2.36.20
MINIO_ROOT_USER=infraadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DATA_DIR=./data/minio
MINIO_CPUS=0.75
MINIO_MEMORY=1g

MONGO_IMAGE=mongo:8.0.28-noble
MONGO_ROOT_USERNAME=infra
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO
MONGO_INITDB_DATABASE=app
MONGO_PORT=27017
MONGO_CPUS=1.00
MONGO_MEMORY=1536m

POSTGRES_BACKUP_BUCKET=postgres-backups
POSTGRES_BACKUP_DIR=./backups/postgres

CLOUDBEAVER_IMAGE=dbeaver/cloudbeaver:25.1.5
CLOUDBEAVER_PORT=8978
PGADMIN_IMAGE=dpage/pgadmin4:9.5
PGADMIN_DEFAULT_EMAIL=admin@example.invalid
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN
PGADMIN_PORT=5050
REDISINSIGHT_IMAGE=redis/redisinsight:2.70
REDISINSIGHT_PORT=5540
MONGO_EXPRESS_IMAGE=mongo-express:1.0.2-20-alpine3.19
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_BASICAUTH_USERNAME=admin
MONGO_EXPRESS_BASICAUTH_PASSWORD=CHANGE_ME_MONGO_EXPRESS
