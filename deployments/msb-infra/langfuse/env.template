# Copy to .env in this directory, then replace every CHANGE_ME.
# Generate each secret with:  openssl rand -hex 32
# LANGFUSE_ENCRYPTION_KEY must be exactly 64 hex chars (openssl rand -hex 32).

# Shared postgres: the langfuse role/db created by bootstrap.sql.
# The host here is the CONTAINER NAME on the shared docker network, not the
# 172.16.0.5 gateway -- that address is only for clients outside this sandbox.
LANGFUSE_DATABASE_URL=postgresql://langfuse:CHANGE_ME_DB@infra-postgres:5432/langfuse

LANGFUSE_SALT=CHANGE_ME_SALT
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME_64_HEX
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH

# MUST be the exact public origin users load, or sign-in breaks with a
# confusing error. Use the tunnel hostname once ingress is live; use
# http://localhost:3100 only while you are still on the SSH tunnel.
LANGFUSE_NEXTAUTH_URL=https://langfuse-dev.mifune.dev

# MUST be true before the hostname is publicly reachable, or anyone who finds
# it can self-register. Leave false only long enough to create your own user.
LANGFUSE_DISABLE_SIGNUP=false

# Token for this sandbox's named tunnel (Cloudflare Zero Trust > Networks >
# Tunnels). The tunnel is shared infrastructure -- one connector can serve
# additional hostnames later, each a public-hostname rule in the dashboard.
# Same variable name prod uses. Only needed with `--profile tunnel up -d`.
CLOUDFLARED_TUNNEL_TOKEN=CHANGE_ME_TUNNEL_TOKEN

# Langfuse-private backing services. Never published; credentialed anyway.
CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE
REDIS_PASSWORD=CHANGE_ME_REDIS
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO
